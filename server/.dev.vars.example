# Copy this file to .dev.vars (never commit .dev.vars) and fill in your own keys.
# These are only used when you run the server on your PC with `npm run dev`.
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPGRAM_API_KEY=
# Any long random string. It protects the admin endpoints (giving credits, stats).
ADMIN_SECRET=change-me-to-something-long
# A fake checkout page so you can test buying credits without real money. Never set this online.
CHECKOUT_MODE=test
